+VIDEO_YEARS = {}
+
+
+def videos_of(year, local=None):
+    """{date: [YouTube id, title]} for one year: the website's own list, or a days.json given with --videos."""
+    if year not in VIDEO_YEARS:
+        got = {}
+        try:
+            if local:
+                full = VIDEO_YEARS.setdefault('all', json.load(open(local)))
+                got = {d: [v[0]['id'], v[0]['title']] for d, v in full.items() if d[:4] == str(year) and v}
+            else:
+                with urllib.request.urlopen(urllib.request.Request(f'{SITE}data/videos/{year}.json', headers={'User-Agent': UA}), timeout=30) as r:
+                    got = json.loads(r.read())
+        except Exception as e:   # no list, no link: the email still goes
+            if not isinstance(e, urllib.error.HTTPError) or e.code != 404:
+                print(f'Video Darshan list for {year} not read: {e}', flush=True)
+        VIDEO_YEARS[year] = got
+    return VIDEO_YEARS[year]
+
+
+def day_video(date, first_years=(), local=None):
+    """BAPS's video of this day (MM-DD of date) in a year gone by: (year, id, title), or None. The years of the photos
+    shown that day first, then the newest year that has one."""
+    md, this = date[5:], int(date[:4])
+    years = [int(y) for y in first_years if y] + list(range(this - 1, 1999, -1))
+    for y in dict.fromkeys(years):
+        v = videos_of(y, local).get(f'{y}-{md}')
+        if v:
+            return y, v[0], v[1]
+    return None
+
+
+def video_button(v, small=False):
+    """The gold Video Darshan link, as on the website: a gold disc with a play mark, then the words and the year."""
+    if not v:
+        return ''
+    y, vid, title = v
+    disc = (f'<span style="display:inline-block;width:18px;height:18px;line-height:18px;border-radius:50%;background:{C["gold"]};'
+            f'color:#3d0e19;font-size:9px;text-align:center;vertical-align:middle;margin-right:7px">&#9654;</span>')
+    href = f'https://www.youtube.com/watch?v={urllib.request.quote(vid)}'
+    if small:
+        return (f'<a href="{href}" title="{esc(title)}" style="color:{C["amber"]};text-decoration:none;white-space:nowrap">'
+                f'{disc}Video Darshan {y}</a>')
+    return (f'<a href="{href}" title="{esc(title)}" style="display:inline-block;font:700 13px {SANS};color:{C["maroon"]};'
+            f'border:1.5px solid {C["gold"]};background:#fff6df;padding:8px 18px 8px 9px;border-radius:999px;text-decoration:none">'
+            f'{disc}<span style="vertical-align:middle">Video Darshan · {y}</span></a>')
+
+
