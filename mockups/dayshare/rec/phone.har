            "size": 5269,
            "mimeType": "text/css; charset=utf-8",
            "compression": 3189,
            "text": "/* bapas-diary.com with no internet (Darpan, 25 Oct 2026). Goes with offline.js. Website only. */\n.bd-off-note { position: fixed; z-index: 90; left: 50%; bottom: 18px; transform: translate(-50%, 30px); opacity: 0; pointer-events: none;\n  padding: 9px 16px; border-radius: 999px; font: 700 12px/1.2 Arimo, Arial, Helvetica, sans-serif; letter-spacing: .06em; white-space: nowrap;\n  color: #3b1219; background: linear-gradient(#ffe296, #ce9840); box-shadow: 0 6px 18px rgba(0, 0, 0, .4); transition: opacity .3s, transform .3s; }\n.bd-off-note.on { opacity: 1; transform: translate(-50%, 0); }\n\n@media (max-width: 760px) {\n  /* above the tab bar on phones */\n  .bd-off-note { bottom: calc(env(safe-area-inset-bottom, 0px) + 76px); }\n  .bd-off-right { display: flex; align-items: center; gap: 8px; }\n}\n/* the Save for travelling button and sheet: phones, and iPads (Darpan, 26 Oct 2026) */\n.bd-off-btn { position: relative; width: 40px; height: 40px; padding: 0; border-radius: 50%; display: grid; place-items: center; cursor: pointer;\n  color: #ffe296; border: 1px solid rgba(217, 164, 65, .45); background: rgba(18, 4, 8, .45); }\n.bd-off-btn svg { width: 20px; height: 20px; }\n.bd-off-btn i { position: absolute; right: 1px; top: 1px; width: 10px; height: 10px; border-radius: 50%; background: #ffe296; border: 2px solid #42101c; display: none; }\n.bd-off-btn.saved i { display: block; }\n\n.bd-off-back { position: fixed; inset: 0; z-index: 95; background: rgba(10, 2, 4, .6); opacity: 0; transition: opacity .3s; }\n.bd-off-back.on { opacity: 1; }\n.bd-off-sheet { position: fixed; z-index: 96; left: 0; right: 0; bottom: 0; max-height: 88dvh; overflow: auto;\n  padding: 10px max(20px, env(safe-area-inset-right, 0px)) calc(env(safe-area-inset-bottom, 0px) + 22px) max(20px, env(safe-area-inset-left, 0px));\n  border-radius: 22px 22px 0 0; border-top: 1px solid rgba(217, 164, 65, .5); color: #faf1de;\n  background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(255, 196, 110, .14), transparent 70%), linear-gradient(#4a1320, #1d070c);\n  font: 400 17px/1.5 \"EB Garamond\", Lora, Georgia, serif; transform: translateY(100%); transition: transform .3s ease; }\n.bd-off-sheet.on { transform: none; }\n.bd-off-grip { width: 44px; height: 5px; border-radius: 3px; background: rgba(250, 241, 222, .3); margin: 0 auto 14px; }\n.bd-off-sheet h2 { margin: 0 0 8px; font: 700 27px/1.1 \"EB Garamond\", Georgia, serif; color: #ffe296; }\n.bd-off-sheet p { margin: 0 0 10px; color: rgba(250, 241, 222, .88); }\n.bd-off-state { min-height: 1.5em; margin: 12px 0 10px; font-size: 17px; }\n.bd-off-state b { color: #ffe296; }\n.bd-off-bar { height: 8px; border-radius: 4px; background: rgba(250, 241, 222, .15); overflow: hidden; margin-bottom: 14px; }\n.bd-off-bar b { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #ce9840, #ffe296); transition: width .2s; }\n.bd-off-go { display: block; width: 100%; min-height: 54px; border: 0; border-radius: 999px; cursor: pointer;\n  font: 700 14px Arimo, Arial, sans-serif; letter-spacing: .14em; text-transform: uppercase; color: #3b1219; background: linear-gradient(#ffe296, #ce9840); }\n.bd-off-go:disabled { opacity: .55; }\n.bd-off-tip { margin-top: 14px !important; font-size: 15px; font-style: italic; }\n.bd-off-row { display: flex; justify-content: space-between; gap: 12px; margin-top: 16px; }\n.bd-off-row button { min-height: 46px; padding: 0 18px; border-radius: 999px; cursor: pointer; background: none;\n  font: 700 12px Arimo, Arial, sans-serif; letter-spacing: .12em; text-transform: uppercase; color: #ffe296; border: 1px solid rgba(217, 164, 65, .55); }\n.bd-off-row .bd-off-close { margin-left: auto; }\n.bd-off-sheet button:focus-visible { outline: 2px solid #ffe296; outline-offset: 3px; }\n/* iPads: the button in the top right corner of the menu, the sheet a card in the middle of the bottom edge */\n@media (min-width: 761px) {\n  nav.site-menu .bd-off-btn { position: absolute; top: 7px; right: 124px; margin: 0; width: 32px; height: 32px; }\n  nav.site-menu .bd-off-btn svg { width: 17px; height: 17px; }\n  nav.site-menu:has(.bd-aa) .bd-off-btn { right: 176px; }\n  nav.site-menu:has(.bd-off-btn) { padding-right: 290px; }\n}\n/* tablets: Save for travelling and Aa in the top left corner, the language switch top right, the tabs in the middle\n   (Darpan, 28 Oct 2026: the tabs were not centred on his mum's tablet; see live/menu.css) */\n@media (min-width: 761px) and (max-width: 1199px) {\n  nav.site-menu .bd-off-btn, nav.site-menu:has(.bd-aa) .bd-off-btn { right: auto; left: 16px; }\n  nav.site-menu:has(.bd-off-btn) .bd-aa { left: 58px; }\n  nav.site-menu:has(.bd-off-btn) { padding-left: 128px; padding-right: 128px; }\n}\n/* iPads standing up: the tabs a little closer, so all six still fit beside the three buttons */\n@media (min-width: 761px) and (max-width: 1100px) {\n  nav.site-menu:has(.bd-off-btn) { gap: 0 10px; }\n  nav.site-menu:has(.bd-off-btn) a { letter-spacing: .06em; }\n  nav.site-menu:has(.bd-off-btn) a.on { padding: 6px 10px 5px; }\n  .bd-off-sheet { left: 50%; right: auto; width: min(560px, 100%); transform: translate(-50%, 100%); }\n  .bd-off-sheet.on { transform: translate(-50%, 0); }\n}\n@media (prefers-reduced-motion: reduce) { .bd-off-note, .bd-off-back, .bd-off-sheet { transition: none; } }\n"
