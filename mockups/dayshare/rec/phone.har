            { "name": "cache-control", "value": "public, max-age=14400, must-revalidate" },
            { "name": "cf-cache-status", "value": "EXPIRED" },
            { "name": "cf-ray", "value": "a524bba04ded2950-DTW" },
            { "name": "content-encoding", "value": "br" },
            { "name": "content-security-policy", "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests" },
            { "name": "content-type", "value": "application/javascript" },
            { "name": "date", "value": "Thu, 29 Oct 2026 19:54:35 GMT" },
