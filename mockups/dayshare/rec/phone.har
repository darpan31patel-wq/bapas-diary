          ],
          "content": {
            "size": 59503,
            "mimeType": "text/html; charset=utf-8",
            "compression": 37761,
            "text": "<!doctype html>\n<html lang=\"en\" translate=\"no\" class=\"notranslate\">\n<head><meta name=\"google\" content=\"notranslate\"><script src=\"/gu/gu.js\"></script>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<link rel=\"stylesheet\" href=\"/menu.css?v=8ee3b5659e\">\n<title>Bapa's Diary</title>\n<meta name=\"description\" content=\"A smruti of Bapa for every day. Open His diary to see where He was.\">\n<link rel=\"canonical\" href=\"https://bapas-diary.com/\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:site_name\" content=\"Bapa's Diary\">\n<meta property=\"og:title\" content=\"Bapa's Diary\">\n<meta property=\"og:description\" content=\"A smruti of Bapa for every day. Open His diary to see where He was.\">\n<meta property=\"og:url\" content=\"https://bapas-diary.com/\">\n<meta property=\"og:image\" content=\"https://bapas-diary.com/share.jpg\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta property=\"og:image:alt\" content=\"Bapa smiling, beside the gold title Bapa's Diary\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32.png\">\n<link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<meta name=\"theme-color\" content=\"#42101c\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-title\" content=\"Bapa's Diary\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n<meta name=\"claude:viewport-fit-sides\" content=\"cover\">\n<style>\n@font-face{font-family:\"Diary Garamond\";font-weight:500;src:url(/fonts/eb-garamond-latin-500-normal.woff2) format(\"woff2\")}\n@font-face{font-family:\"Diary Garamond\";font-weight:600;src:url(/fonts/eb-garamond-latin-600-normal.woff2) format(\"woff2\")}\n@font-face{font-family:\"Diary Garamond\";font-weight:700;src:url(/fonts/eb-garamond-latin-700-normal.woff2) format(\"woff2\")}\n@font-face{font-family:\"Diary Arimo\";font-weight:700;src:url(/fonts/arimo-latin-700-normal.woff2) format(\"woff2\")}\n/* Layout: the 2pm On this day picture as a living page. Maroon ground, gold title, a board of ivory polaroids\n   hanging straight on cords (one cord per row), each card fading through its year; under it every photo of the day. */\n:root{\n  --maroon-in:#42101c; --maroon-out:#160509; --maroon-ink:#6e1424; --maroon-deep:#2a0a12;\n  --gold-hi:#ffe296; --gold:#ce9840; --gold-soft:#d9a441;\n  --ivory-top:#f8f2e4; --ivory-bot:#eadfc8; --ivory-edge:#c4b292; --cream:#faf1de;\n  --cord:#c9a46a; --mist:rgba(250,241,222,.62);\n  --serif:\"Diary Garamond\",\"EB Garamond\",Garamond,\"Times New Roman\",serif;\n  --sans:\"Diary Arimo\",Arimo,Arial,Helvetica,sans-serif;\n  color-scheme:dark;\n}\nhtml,body{min-height:100%}\n[hidden]{display:none!important}\n*,*::before,*::after{box-sizing:border-box}\nbody{background:var(--maroon-out);color:var(--cream);font-family:var(--serif)}\na{color:inherit}\nbutton{font:inherit;color:inherit}\n:focus-visible{outline:2px solid var(--gold-hi);outline-offset:3px}\n.page{min-height:100vh;overflow-x:clip;background:\n  radial-gradient(ellipse 60% 30% at 50% 0%,rgba(255,196,110,.16),transparent 70%),\n  radial-gradient(ellipse 90% 70% at 50% 30%,var(--maroon-in),var(--maroon-out)) no-repeat;\n  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:calc(46px + 14px) 48px}\n.wrap{max-width:1500px;margin:0 auto}\n.caps{font:700 11px/1.2 var(--sans);letter-spacing:.2em;text-transform:uppercase}\n\n/* date bar */\n.datebar{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:8px}\n.pill{font:700 11px/1 var(--sans);letter-spacing:.14em;text-transform:uppercase;background:rgba(0,0,0,.22);color:var(--gold-hi);border:1px solid rgba(217,164,65,.45);border-radius:999px;padding:10px 16px;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:8px}\n.pill:hover{background:rgba(217,164,65,.14)}\n.pill.solid{background:var(--gold-soft);color:var(--maroon-out);border-color:var(--gold-soft)}\n.pill[hidden]{display:none}\n\nheader{text-align:center;margin:clamp(22px,3vw,40px) 0 clamp(4px,1.5vw,18px)}   /* a little more room between the lines on wider screens (Darpan, 26 Oct 2026: \"spread this out a bit\") */\nh1{font:700 clamp(46px,9vw,100px)/1 var(--serif);margin:0;background:linear-gradient(var(--gold-hi),var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 2px 2px rgba(0,0,0,.45));text-wrap:balance}\n.sub{display:flex;align-items:center;justify-content:center;gap:clamp(14px,1.6vw,24px);margin-top:clamp(12px,2vw,26px);font:700 clamp(11px,1.4vw,14px)/1 var(--sans);letter-spacing:.42em;color:var(--gold-soft);padding-left:.42em}\n.sub::before,.sub::after{content:\"\";width:clamp(48px,7vw,120px);height:1px;background:linear-gradient(90deg,transparent,var(--gold-soft))}\n.sub::after{transform:scaleX(-1)}\n.tithi{margin:clamp(16px,2.4vw,32px) auto 0;font:500 clamp(17px,2vw,21px)/1.4 var(--serif);color:var(--cream);text-wrap:balance;max-width:44ch}\n.tithi b{font-weight:700;color:var(--gold-hi)}\n.count{margin:clamp(10px,1.4vw,18px) auto 0;font:500 16.5px/1.45 var(--serif);color:var(--cream);max-width:60ch;text-wrap:balance}\n@media (min-width:1000px){.count{max-width:none}}   /* one line across on computers, brighter (Darpan, 26 Oct 2026: too faint) */\n\n/* Computers: the header packed closer, so ropes 1 and 2 show as the page opens (Darpan, 29 Oct 2026: \"I don't like how\n   much dead space there is at the top ... I want rope 1 and 2 a little bit higher up the page\"). Same order as before,\n   centred: the tithi and the count share one line, and the email and Screensaver buttons sit side by side. */\n@media (min-width:1180px){\n  header{display:flex;flex-wrap:wrap;justify-content:center;align-items:baseline;column-gap:18px;margin:clamp(10px,1.2vw,18px) 0 0}\n  h1,.sub,#mocknote{flex:0 0 100%}\n  h1{font-size:clamp(58px,5.6vw,80px)}\n  .sub{margin-top:12px}\n  .tithi{margin:18px 0 0;max-width:none}\n  .count{margin:18px 0 0;font-size:15.5px}\n  .count::before{content:\"·\";margin-right:18px;color:var(--gold-soft)}\n  header .remind,header .ss-launch{margin:16px 0 0;align-self:center}\n  header .ss-big{padding:12px 28px}\n  .board{margin-top:18px}\n}\n\n/* board */\n.board{position:relative;margin-top:30px}\n.cords{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;overflow:visible}\n.cards{position:relative;display:grid;grid-template-columns:repeat(auto-fill,minmax(168px,1fr));column-gap:clamp(12px,1.6vw,26px);row-gap:clamp(30px,3.4vw,46px);padding-top:16px}\n@media (max-width:520px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}\n.slot{display:flex;flex-direction:column;align-items:center;min-width:0}\n.card{position:relative;display:block;width:100%;background:linear-gradient(var(--ivory-top),var(--ivory-bot));border:1px solid var(--ivory-edge);padding:3.5% 3.5% 0;box-shadow:0 10px 18px rgba(0,0,0,.42),0 2px 4px rgba(0,0,0,.3);cursor:pointer;text-align:center;text-decoration:none;transform-origin:50% -12px;will-change:transform}\n.peg{position:absolute;left:50%;top:-17px;width:12px;height:30px;margin-left:-6px;border-radius:6px 6px 3px 3px;background:linear-gradient(90deg,#6b4022,#b07a4a 30%,#9a6538 55%,#5d361c);box-shadow:1px 3px 4px rgba(0,0,0,.45);z-index:2}\n.peg::after{content:\"\";position:absolute;left:1px;right:1px;top:12px;height:3px;background:#3a2210;opacity:.7}\n.photo{position:relative;aspect-ratio:3/4;max-width:100%;overflow:hidden;background:var(--maroon-deep)}\n/* each photo sits on its own layer with its softened fill; the next photo's layer fades in on top of the one showing,\n   which stays fully there until it is covered, so the change is a clean dissolve with no dark dip in the middle\n   (Darpan, 28 Oct 2026: some pictures weren't fading or changing as expected) */\n.photo .layer{position:absolute;inset:0;opacity:0;z-index:0}\n.photo .layer.on{opacity:1}\n.photo .layer.top{z-index:1;transition:opacity 3s ease-in-out}\n.photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}\n/* and it never sits still: each photo drifts slowly closer to Bapa's face and back, out of step with the others, so the\n   board feels alive between the changes (Darpan, 28 Oct 2026) */\n.photo .layer img:not(.bg){transform-origin:var(--fx,50%) var(--fy,30%);animation:breathe 20s ease-in-out infinite alternate;animation-delay:var(--wait,0s)}\n@keyframes breathe{from{transform:scale(1)}to{transform:scale(var(--zoom,1.03))}}\n.paused .photo .layer img{animation-play-state:paused}\n/* Darpan, 25 Oct 2026 (the On this day picture's rules): Bapa's whole head stays in the frame; any space left when it\n   has to zoom out is filled with the photo's own colours, softened (make.fill) */\n.photo img.placed{inset:auto;max-width:none;object-fit:fill}\n.photo img.bg{inset:-8%;width:116%;height:116%;object-fit:cover;filter:blur(12px) brightness(.72)}\n.photo .words{position:absolute;inset:0;z-index:2;display:grid;place-items:center;padding:12%;background:radial-gradient(circle at 50% 40%,#5a1626,var(--maroon-deep));transition:opacity 3s ease-in-out}\n.photo .words p{margin:0;font:500 clamp(14px,1.3vw,16px)/1.35 var(--serif);font-style:italic;color:var(--gold-hi);text-align:center;text-wrap:balance;overflow-wrap:anywhere;transition:opacity 1.5s ease-in-out}\n.photo .words.off{opacity:0}\n.photo.story{display:grid;place-items:center;padding:12%;background:radial-gradient(circle at 50% 40%,#5a1626,var(--maroon-deep))}\n.photo.story p{margin:0;font:500 clamp(14px,1.3vw,16px)/1.35 var(--serif);font-style:italic;color:var(--gold-hi);text-wrap:balance}\n.label{padding:9px 2px 10px;color:var(--maroon-ink)}\n.yr{font:700 clamp(24px,2.3vw,30px)/1 var(--serif)}\n.pl{margin-top:6px;font:800 clamp(12.5px,1.1vw,15px)/1.2 var(--sans);letter-spacing:.11em;text-transform:uppercase;color:var(--maroon-ink);text-wrap:balance;overflow-wrap:anywhere}   /* year and place are the biggest words on a card (Darpan, 26 Oct 2026) */\n.ti{margin-top:4px;font:500 12.5px/1.25 var(--serif);font-style:italic;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.fest{display:inline-block;margin-top:5px;max-width:100%;font:700 8.5px/1.25 var(--sans);letter-spacing:.14em;text-transform:uppercase;background:var(--maroon-ink);color:var(--gold-hi);padding:3px 7px;border-radius:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.of{margin-top:5px;font:700 8.5px/1 var(--sans);letter-spacing:.16em;color:rgba(110,20,36,.6);font-variant-numeric:tabular-nums}\n.cap{margin-top:11px;min-height:2.8em;width:100%;text-align:center;font:500 15px/1.35 var(--serif);color:var(--cream);transition:opacity 1.5s ease-in-out;text-wrap:balance;max-width:100%;overflow-wrap:anywhere;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}\n.cap.fade{opacity:0}\n\n.controls{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:28px;align-items:center}\n.controls select{font:700 11px var(--sans);letter-spacing:.1em;text-transform:uppercase;background:rgba(0,0,0,.25);color:var(--gold-hi);border:1px solid rgba(217,164,65,.45);border-radius:999px;padding:9px 12px;cursor:pointer}\n.controls label{font:700 10px var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--gold-soft)}\n\n/* every photo of the day */\n.all{margin-top:56px;border-top:1px solid rgba(217,164,65,.22);padding-top:30px}\n.all>h2{margin:0;text-align:center;font:700 clamp(28px,4vw,42px)/1.1 var(--serif);color:var(--gold-hi);text-wrap:balance}\n.all>p{text-align:center;color:var(--mist);margin:8px 0 0;font-size:15px}\n.yeargroup{margin-top:34px;scroll-margin-top:16px}\n.yhead{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 14px;padding-bottom:10px;border-bottom:1px solid rgba(217,164,65,.18)}\n.yhead h3{margin:0;font:700 30px/1 var(--serif);color:var(--gold-hi)}\n.yhead .caps{color:var(--gold-soft)}\n.yhead .it{font:500 16px var(--serif);font-style:italic;color:var(--cream)}\n.yhead .fest{margin:0;background:var(--gold-soft);color:var(--maroon-out)}\n.yhead a{margin-left:auto}\n/* the gold Photos button: that day's photos in Search (Darpan, 28 Oct 2026) */\n.go{display:inline-block;padding:6px 13px;border:1px solid var(--go,var(--gold-soft));border-radius:999px;color:var(--go,var(--gold-soft));font:600 11.5px/1.2 var(--sans);letter-spacing:.08em;text-transform:uppercase;text-decoration:none;white-space:nowrap}\n.go:hover,.go:focus-visible{background:var(--go,var(--gold-soft));color:var(--go-on,var(--maroon-out));outline:none}\n.vcap{--go:var(--maroon-ink);--go-on:var(--gold-hi)}\n.vcap .go{margin-top:9px}\n.story-line{margin:12px 0 0;font:500 16px/1.45 var(--serif);font-style:italic;color:var(--cream);max-width:70ch}\n.story-line b{font-style:normal;font:700 10px var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--gold-soft);margin-right:8px}\n.tripnote{margin:18px 0 0;font:700 10px var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--gold-soft)}\n.thumbs{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:10px;margin-top:12px}\n.thumb{display:block;padding:5px 5px 0;background:linear-gradient(var(--ivory-top),var(--ivory-bot));border:0;cursor:pointer;box-shadow:0 4px 8px rgba(0,0,0,.35);min-width:0}\n.thumb .im{display:block;aspect-ratio:1;max-width:100%;background:var(--maroon-deep) center/cover no-repeat;overflow:hidden}\n.thumb img{width:100%;height:100%;object-fit:cover;display:block}\n.thumb small{display:block;padding:5px 2px 6px;font:500 11.5px/1.25 var(--serif);color:var(--maroon-ink);text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n\n\n/* the wide view and the slideshow */\n.viewer{position:fixed;inset:0;z-index:60;background:rgba(14,3,6,.96);display:grid;grid-template-rows:auto minmax(0,1fr) auto;padding:calc(10px + env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-right,0px)) calc(14px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px))}\n.vtop{display:flex;justify-content:space-between;align-items:center;gap:10px}\n.vtop .caps{color:var(--gold-soft)}\n.vstage{position:relative;display:grid;place-items:center;min-height:0;padding:12px 0}\n.vframe{background:linear-gradient(var(--ivory-top),var(--ivory-bot));padding:10px 10px 0;max-width:100%;max-height:100%;display:flex;flex-direction:column;box-shadow:0 18px 40px rgba(0,0,0,.6)}\n.vframe img{display:block;max-width:min(92vw,1100px);max-height:calc(100vh - 230px);object-fit:contain;margin:0 auto}\n.vframe .none{width:min(80vw,520px);aspect-ratio:4/3;display:grid;place-items:center;padding:8%;background:radial-gradient(circle at 50% 40%,#5a1626,var(--maroon-deep));color:var(--gold-hi);font:500 italic 20px/1.4 var(--serif);text-align:center}\n.thumb .im.words{display:grid;place-items:center;padding:8px;background:radial-gradient(circle at 50% 40%,#5a1626,var(--maroon-deep));color:var(--gold-hi);font:500 italic 12px/1.3 var(--serif);text-align:center;overflow:hidden}\n.vcap{padding:10px 6px 12px;color:var(--maroon-ink);text-align:center;max-width:min(92vw,1100px)}\n.vcap p{margin:0;font:500 17px/1.35 var(--serif);text-wrap:balance}\n.vcap div{margin-top:5px;font:700 9.5px/1.4 var(--sans);letter-spacing:.18em;text-transform:uppercase}\n.vnav{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}\n.viewer.play .vframe img{animation:breathe 7s ease-in-out both}\n@keyframes breathe{from{transform:scale(1)}to{transform:scale(1.025)}}\n\n/* choose a day */\n.picker{position:fixed;inset:0;z-index:40;background:rgba(14,3,6,.9);display:grid;place-items:center;padding:16px max(16px,env(safe-area-inset-right,0px)) 16px max(16px,env(safe-area-inset-left,0px))}\n.pbox{background:linear-gradient(var(--ivory-top),var(--ivory-bot));color:var(--maroon-ink);width:min(440px,100%);padding:20px 18px 18px;box-shadow:0 18px 40px rgba(0,0,0,.6)}\n.pbox h2{margin:0;font:700 26px var(--serif);text-align:center}\n.months{display:flex;justify-content:space-between;align-items:center;margin-top:14px}\n.months button{background:none;border:1px solid var(--ivory-edge);border-radius:999px;width:38px;height:38px;cursor:pointer;color:var(--maroon-ink);font:700 16px var(--sans)}\n.months b{font:600 22px var(--serif)}\n.daygrid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px;margin-top:12px}\n.daygrid button{aspect-ratio:1;border:1px solid var(--ivory-edge);background:rgba(255,255,255,.4);color:var(--maroon-ink);font:600 17px var(--serif);cursor:pointer;border-radius:3px;font-variant-numeric:tabular-nums}\n.daygrid button.on{background:var(--maroon-ink);color:var(--gold-hi);border-color:var(--maroon-ink)}\n.daygrid button.today{box-shadow:inset 0 0 0 2px var(--gold)}\n.pbox .pill{margin:16px auto 0;display:flex;width:max-content;color:var(--maroon-ink);border-color:var(--ivory-edge);background:none}\n\n.loading{text-align:center;margin:60px 0;color:var(--mist);font:500 18px var(--serif);font-style:italic}\n.mocknote{margin:14px auto 0;max-width:62ch;text-align:center;font:500 14px/1.45 var(--serif);color:var(--gold-hi);background:rgba(0,0,0,.25);border:1px dashed rgba(217,164,65,.45);padding:9px 14px}\n@media (prefers-reduced-motion:reduce){.photo .layer.top{transition-duration:1.2s}.photo .layer img{animation:none!important}.cap{transition:none}.viewer.play .vframe img{animation:none}}\n/* Easier to read on a phone: the smallest words a little bigger (website review, 28 Oct 2026) */\n.thumb small{font-size:12.5px;line-height:1.25;white-space:normal;text-overflow:clip;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n.yhead .caps{font-size:12.5px}\n.yhead a,.story-line b,.yeargroup .tripnote{font-size:12px}\n.label .fest{font-size:11px}\n</style>\n<script>try{var z=+localStorage.getItem('bapas-diary-text');if(z>1)document.documentElement.style.zoom=z}catch(e){}</script>\n<link rel=\"stylesheet\" href=\"/extras.css\">\n<script src=\"/extras.js\" defer></script>\n<link rel=\"stylesheet\" href=\"/player/player.css\">\n<script src=\"/player/player.js\" defer></script>\n<link rel=\"stylesheet\" href=\"/phone.css\">\n<script src=\"/phone.js\" defer></script>\n<style id=\"look-d\">/* the On this day picture's finish, look D (Darpan, 19 Oct 2026) */img[src*=\"photos.bapas-diary.com/\"],img[src^=\"p/\"],img[src*=\"/p/\"],.photo img,.thumb img,.vframe img{filter:brightness(.98) contrast(1.1) saturate(1.13) sepia(.07)}</style>\n<link rel=\"stylesheet\" href=\"/type.css?v=3476f2aadd\" id=\"site-type\"><link rel=\"stylesheet\" href=\"/offline.css\">\n<script src=\"/offline.js\" defer></script>\n<link rel=\"stylesheet\" href=\"/screensaver/launch.css\">\n<script src=\"/screensaver/launch.js\" defer></script>\n</head>\n<body>\n<nav class=\"site-menu\" aria-label=\"Website tabs\"><a href=\"/\" class=\"on\" aria-current=\"page\">Today</a><a href=\"/calendar/\">Calendar</a><a href=\"/search/\">Search</a><a href=\"/travels/\">Travels</a><a href=\"/through-the-years/\">Through the years</a><a href=\"/then-and-now/\">Legacy</a><a href=\"/about/\">About</a></nav><script id=\"menu-faint\">(function(){var n=document.querySelector(\"nav.site-menu\");if(!n)return;addEventListener(\"scroll\",function(e){var t=e.target.nodeType===9?document.scrollingElement:e.target;if(t&&t.scrollHeight>innerHeight*.6)n.classList.toggle(\"faint\",t.scrollTop>40)},{passive:true,capture:true})})()</script>\n<div class=\"page\"><div class=\"wrap\">\n\n  <div class=\"datebar\">\n    <button class=\"pill\" id=\"prev\" type=\"button\"></button>\n    <button class=\"pill solid\" id=\"choose\" type=\"button\">Choose a day</button>\n    <button class=\"pill\" id=\"next\" type=\"button\"></button>\n    <button class=\"pill\" id=\"back-today\" type=\"button\" hidden>Back to today</button>\n  </div>\n\n  <header>\n    <h1 id=\"title\"></h1>\n    <div class=\"sub\" id=\"subtitle\">IN BAPA'S DIARY</div>\n    <p class=\"tithi\" id=\"tithi\" hidden></p>\n    <p class=\"count\" id=\"count\"></p>\n    <div id=\"mocknote\"></div>\n<!-- The small \"On this day\" email sign up on the Today page (Darpan, 26 Oct 2026: \"a small sign up so people get\n     today's darshan link each morning\"). Website only. Goes inside the Today page's <header>, after #count.\n     Closed it is one quiet line; tapped, it opens a little form with the two choices: each morning, every Sunday.\n     It posts to /api/weekly (functions/api/weekly.js), which sends the \"please confirm\" email. -->\n<div class=\"remind\" id=\"remind\">\n  <style>\n    .remind { margin: 14px auto 0; max-width: 560px; font: 15px/1.4 Arimo, Arial, sans-serif; color: #f3e4c6; }\n    .remind .rm-open { font: 700 12px Arimo, Arial, sans-serif; letter-spacing: .14em; text-transform: uppercase; color: #d9a441; background: none;\n      border: 1px solid rgba(217, 164, 65, .55); border-radius: 999px; padding: 8px 16px; cursor: pointer; }\n    .remind .rm-open:hover { color: #ffe296; border-color: #ffe296; }\n    .remind form { display: grid; gap: 10px; justify-items: center; margin-top: 4px; }\n    .remind .rm-row { display: flex; gap: 8px; width: 100%; flex-wrap: wrap; }\n    .remind input[type=email] { flex: 1 1 220px; min-width: 0; font: 16px Arimo, Arial, sans-serif; padding: 10px 14px; border-radius: 8px;\n      border: 1px solid #d9a441; background: #faf1de; color: #2e1a14; }\n    .remind button[type=submit] { flex: 0 0 auto; font: 700 12px Arimo, Arial, sans-serif; letter-spacing: .1em; text-transform: uppercase;\n      padding: 10px 16px; border-radius: 8px; border: 0; background: #d9a441; color: #3d0e19; cursor: pointer; }\n    .remind button[type=submit]:hover { background: #ffe296; }\n    .remind .rm-choices { display: flex; gap: 8px 18px; flex-wrap: wrap; justify-content: center; font-size: 14px; }\n    .remind .rm-choices label { display: inline-flex; gap: 6px; align-items: center; cursor: pointer; }\n    .remind .rm-choices input { accent-color: #d9a441; width: 16px; height: 16px; }\n    .remind .rm-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }\n    .remind small { font-size: 12px; color: #d9c3a0; }\n    .remind .rm-err { color: #ffb4a8; font-size: 13px; min-height: 1em; }\n    .remind .rm-done { font: 500 18px/1.4 \"EB Garamond\", Georgia, serif; color: #ffe296; margin: 0; }\n    .remind :focus-visible { outline: 2px solid #ffe296; outline-offset: 2px; }\n    @media (max-width: 600px) { .remind { padding: 0 16px; } .remind .rm-row { flex-direction: column; } .remind input[type=email], .remind button[type=submit] { flex: none; width: 100%; } }\n  </style>\n  <button class=\"rm-open\" type=\"button\" aria-expanded=\"false\">✉ Today's darshan by email</button>\n  <form hidden>\n    <div class=\"rm-row\">\n      <label class=\"rm-hp\" aria-hidden=\"true\">Leave this empty <input name=\"website\" tabindex=\"-1\" autocomplete=\"off\"></label>\n      <input id=\"remind-email\" name=\"email\" type=\"email\" placeholder=\"Your email\" autocomplete=\"email\" required aria-label=\"Your email\">\n      <button type=\"submit\">Remind me</button>\n    </div>\n    <div class=\"rm-choices\">\n      <label><input type=\"checkbox\" name=\"daily\" checked> Each morning, today's darshan</label>\n      <label><input type=\"checkbox\" name=\"weekly\"> Every Sunday, the week's darshan</label>\n    </div>\n    <div class=\"rm-err\" role=\"status\"></div>\n    <small>A page from Bapa’s Diary, straight into your inbox for your Smruti. Free, and you can stop any time with one tap.</small>\n  </form>\n  <script>\n  (function () {\n    var box = document.currentScript.parentNode, open = box.querySelector('.rm-open'), form = box.querySelector('form'), err = box.querySelector('.rm-err');\n    open.addEventListener('click', function () { open.hidden = true; form.hidden = false; open.setAttribute('aria-expanded', 'true'); form.email.focus(); });\n    form.addEventListener('submit', function (e) {\n      e.preventDefault();\n      var lists = [];\n      if (form.daily.checked) lists.push('daily');\n      if (form.weekly.checked) lists.push('weekly');\n      if (!lists.length) { err.textContent = 'Please tick at least one.'; return; }\n      var btn = form.querySelector('button'), email = form.email.value.trim();\n      btn.disabled = true; err.textContent = '';\n      fetch('/api/weekly', { method: 'POST', headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ email: email, lists: lists, website: form.website.value }) })\n        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })\n        .then(function (res) {\n          if (!res.ok) throw new Error(res.j.error || 'Sorry, something went wrong. Please try again.');\n          var p = document.createElement('p'); p.className = 'rm-done';\n          p.textContent = 'Thank you 🙏🏽 Please open the email we just sent to ' + email + ' and tap the button in it.';\n          form.replaceWith(p);\n        })\n        .catch(function (x) { err.textContent = x.message || 'Sorry, something went wrong. Please try again.'; btn.disabled = false; });\n    });\n  })();\n  </script>\n</div>\n  <div class=\"ss-launch\"><button type=\"button\" id=\"screensaverButton\" class=\"ss-big\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5c1.8 2.4 2.6 4 2.2 5.6-.3 1.3-1.3 2-2.2 2s-1.9-.7-2.2-2C9.4 6.5 10.2 4.9 12 2.5z\"/><path d=\"M2.5 12.5h19c-.6 4.2-4.6 7-9.5 7s-8.9-2.8-9.5-7z\"/><rect x=\"9\" y=\"20.2\" width=\"6\" height=\"1.6\" rx=\".8\"/></svg>Screensaver</button></div>\n</header>\n\n  <div class=\"loading\" id=\"loading\">Opening the diary</div>\n  <div class=\"board\" id=\"board\" hidden>\n    <svg class=\"cords\" id=\"cords\" aria-hidden=\"true\"></svg>\n    <div class=\"cards\" id=\"cards\"></div>\n  </div>\n\n  <div class=\"controls\" id=\"controls\" hidden>\n    <button class=\"pill\" id=\"pause\" type=\"button\">Pause</button>\n    <label for=\"speed\">Speed</label>\n    <select id=\"speed\"><option value=\"2000\">Slow</option><option value=\"1000\" selected>Gentle</option><option value=\"700\">Quick</option></select>\n    <button class=\"pill\" id=\"slideshow\" type=\"button\">Slideshow</button>\n    <a class=\"pill\" id=\"search-day\" target=\"_blank\" rel=\"noopener\">Search this date</a>\n  </div>\n\n  <section class=\"all\" id=\"all\" hidden>\n    <h2 id=\"all-title\"></h2>\n    <p id=\"all-count\"></p>\n    <div id=\"groups\"></div>\n  </section>\n\n</div></div>\n\n<div class=\"viewer\" id=\"viewer\" hidden role=\"dialog\" aria-modal=\"true\" aria-label=\"Photo\">\n  <div class=\"vtop\"><span class=\"caps\" id=\"vpos\"></span><button class=\"pill solid\" id=\"vclose\" type=\"button\">Close</button></div>\n  <div class=\"vstage\" id=\"vstage\"></div>\n  <div class=\"vnav\">\n    <button class=\"pill\" id=\"vprev\" type=\"button\">Previous</button>\n    <button class=\"pill\" id=\"vplay\" type=\"button\">Play</button>\n    <button class=\"pill\" id=\"vnext\" type=\"button\">Next</button>\n  </div>\n</div>\n\n<div class=\"picker\" id=\"picker\" hidden role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"picker-title\">\n  <div class=\"pbox\">\n    <h2 id=\"picker-title\">Choose a day</h2>\n    <div class=\"months\"><button type=\"button\" id=\"pm-prev\" aria-label=\"Previous month\">‹</button><b id=\"pm-name\"></b><button type=\"button\" id=\"pm-next\" aria-label=\"Next month\">›</button></div>\n    <div class=\"daygrid\" id=\"daygrid\"></div>\n    <button class=\"pill\" id=\"pclose\" type=\"button\">Close</button>\n  </div>\n</div>\n\n<script>\n// Where things are. The website build fills these in; a mockup may replace SRC.day and SRC.photo.\nconst SRC = {\n  day: mmdd => fetch('/data/day/' + mmdd + '.json').then(r => { if (!r.ok) throw r.status; return r.json(); }),\n  photo: p => 'https://photos.bapas-diary.com/s/' + p[0] + '/' + p[1],\n  big: p => 'https://photos.bapas-diary.com/m/' + p[0] + '/' + p[1],\n  search: d => '/search/#' + (d.length === 5 ? 'day=' : 'date=') + d,   // '10-24' every year on this date, '2014-10-24' one day\n};\nif (window.MOCK) Object.assign(SRC, window.MOCK);\n\nconst $ = id => document.getElementById(id);\nconst MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];\nconst LEN = [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\nconst reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;\nconst pad = n => String(n).padStart(2, '0');\nlet now = new Date();\nlet TODAY = pad(now.getMonth() + 1) + '-' + pad(now.getDate());\nconst nice = m => `${+m.slice(3)} ${MONTHS[+m.slice(0, 2) - 1]}`;\nconst short = m => `${+m.slice(3)} ${MONTHS[+m.slice(0, 2) - 1].slice(0, 3)}`;\nfunction shift(m, n) {\n  const d = new Date(2000, +m.slice(0, 2) - 1, +m.slice(3) + n);   // 2000 has 29 February\n  return pad(d.getMonth() + 1) + '-' + pad(d.getDate());\n}\nconst esc = s => String(s).replace(/[&<>\"]/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;'}[c]));\n// Today only tags these 12 festivals, matched across the calendar's spellings (Darpan, 26 Oct 2026: \"just these 12\")\nconst KEEP = [['Diwali', /^diwali\\b/i], ['Annakut', /annakut/i], ['New Year', /bestu|nutan varsh|^new year$/i],\n  ['Janmashtami', /janmashtami/i], ['Guru Purnima', /guru purnima/i], ['Swaminarayan Jayanti', /hari-?nom|swaminarayan jayanti|swaminarayan's birthday/i],\n  ['Vasant Panchami', /vasant panch/i], ['Holi', /^holi\\b/i], ['Rathyatra', /rath ?yatra/i], ['Raksha Bandhan', /raksha ?bandhan/i],\n  ['Ekadashi', /^(?!.*(smart|shra?d?dh|vruddhi|sabha)).*ek[aãp]dashi/i], ['Pushpadolotsav', /pushpadol|fuldol/i]];\nconst festsOf = c => {\n  if (!c) return [];\n  const parts = [c[1], c[2]].filter(Boolean).join(';').split(/[;,\\/]/).map(x => x.trim()).filter(Boolean);\n  return KEEP.filter(([, re]) => parts.some(x => re.test(x))).map(([name]) => name);\n};\nconst festOf = c => festsOf(c).join(' · ');\nconst tithiOf = c => c ? c[0] : '';\n\nlet DAY = null, cards = [], everyPhoto = [], timers = [], paused = false, showing = null;\n\n// On this day means the years gone by: today, and the days still to come this year, never show this year's own card or\n// story, only on the days already past (Darpan, 28 Oct 2026: \"no 2026 pictures on the present day, doesn't make sense\").\n// Worked out in the browser from its own clock, so it turns over by itself at New Year.\nfunction pastOnly(D) {\n  if (D.date < TODAY) return D;\n  const y = now.getFullYear();\n  return Object.assign({}, D, {years: D.years.filter(Y => Y.y < y), stories: (D.stories || []).filter(s => s[0] < y)});\n}\n\n// the date in the address (#10-24) opens that day; no date opens today\nfunction wanted() { const h = location.hash.slice(1); return /^\\d\\d-\\d\\d$/.test(h) && +h.slice(3) <= LEN[+h.slice(0, 2) - 1] ? h : TODAY; }\n\nasync function open(mmdd, push) {\n  stop();\n  showing = mmdd;\n  if (push) history.replaceState(null, '', mmdd === TODAY ? location.pathname + location.search : '#' + mmdd);\n  $('title').textContent = nice(mmdd);\n  $('subtitle').textContent = mmdd === TODAY ? \"TODAY IN BAPA'S DIARY\" : \"IN BAPA'S DIARY\";\n  $('prev').textContent = '‹ ' + short(shift(mmdd, -1));\n  $('next').textContent = short(shift(mmdd, 1)) + ' ›';\n  $('back-today').hidden = mmdd === TODAY;\n  $('loading').hidden = false; $('board').hidden = $('controls').hidden = $('all').hidden = true;\n  $('tithi').hidden = true; $('count').textContent = ''; $('mocknote').innerHTML = '';\n  document.title = mmdd === TODAY ? \"Bapa's Diary\" : `${nice(mmdd)} in Bapa's Diary`;\n  let data;\n  try { data = await SRC.day(mmdd); } catch (e) { $('loading').textContent = 'This day could not be opened. Please try again in a moment.'; return; }\n  if (showing !== mmdd) return;\n  DAY = pastOnly(data);\n  $('loading').hidden = true;\n  render();\n}\n\nfunction render() {\n  const D = DAY, year = String(now.getFullYear());\n  // this date in the BAPS calendar this year\n  const c = D.cal && D.cal[year];\n  if (c) {\n    const f = [c[1], c[2]].filter(Boolean).join('; ');\n    $('tithi').innerHTML = `${D.date === TODAY ? 'Today is' : `In ${year} this date is`} <b>${esc(c[0])}</b>${f ? ', ' + esc(f) : ''}`;\n    $('tithi').hidden = false;\n  }\n  // one card per year: its photos, or, for the older years, the On this day story\n  const byYear = {};\n  D.years.forEach(Y => byYear[Y.y] = {Y, stories: []});\n  D.stories.forEach(([y, place, line]) => {   // the same story can come from two sources: show it once\n    const b = byYear[y] = byYear[y] || {Y: null, place, stories: []};\n    if (!b.stories.includes(line)) b.stories.push(line);\n  });\n  const years = Object.keys(byYear).map(Number).sort((a, b) => a - b);\n  everyPhoto = [];\n  const n = D.years.reduce((s, Y) => s + Y.p.length + (Y.t || []).length, 0);\n  const shown = D.years.filter(Y => Y.p.length || (Y.t || []).length).length;\n  $('count').textContent = n ? `${shown} years and ${n.toLocaleString()} photos from this day. Each card fades through all of its year's photos. Tap a card to see them all.`\n                             : `${years.length} years remembered on this day.`;\n  if (window.MOCK && MOCK.note && MOCK.note(D.date)) $('mocknote').innerHTML = `<p class=\"mocknote\">${MOCK.note(D.date)}</p>`;\n\n  $('cards').innerHTML = ''; $('groups').innerHTML = '';\n  // a card only for a year with photos of Bapa; a year with only its On this day lines lists them below, with no empty\n  // card on the rope (Darpan, 26 Oct 2026)\n  const hasPhotos = b => b.Y && (b.Y.p.length || (b.Y.t || []).length);\n  // the first impression is a mix: about half the cards open on a close up, half on an activity photo, shuffled at\n  // each visit (Darpan, 26 Oct 2026)\n  const withPhotos = years.filter(y => hasPhotos(byYear[y]));\n  const order = withPhotos.map((_, i) => i).sort(() => Math.random() - .5), closeUp = new Set(order.slice(0, Math.ceil(order.length / 2)));\n  cards = withPhotos.map((y, i) => card(y, byYear[y], closeUp.has(i)));\n  years.filter(y => !hasPhotos(byYear[y])).forEach(y => group(y, null, byYear[y].place, DAY.cal && DAY.cal[y], byYear[y].stories));\n  [...$('groups').children].sort((a, b) => a.id.slice(1) - b.id.slice(1)).forEach(g => $('groups').append(g));\n  $('board').hidden = $('controls').hidden = false;\n  $('search-day').href = SRC.search(D.date);\n  $('all-title').textContent = `Every photo from ${D.title}`;\n  $('all-count').textContent = n ? `${n.toLocaleString()} photos, year by year` : 'No photos on this day yet';\n  $('all').hidden = !n;\n  requestAnimationFrame(cords);\n  start();\n}\n\nfunction card(y, {Y, place, stories}, want = true) {\n  const photos = Y ? (Y.p.length ? Y.p : Y.t || []) : [];\n  const where = Y ? Y.place : place;\n  const cal = DAY.cal && DAY.cal[y];\n  const slot = document.createElement('div'); slot.className = 'slot';\n  const el = document.createElement('a'); el.className = 'card';\n  el.href = '#y' + y;\n  el.addEventListener('click', e => { e.preventDefault(); const g = $('y' + y); if (g) g.scrollIntoView({behavior: reduce ? 'auto' : 'smooth'}); else if (photos.length) view(0); });\n  el.setAttribute('aria-label', photos.length ? `${y}, ${where}: see all ${photos.length} photos` : `${y}, ${where}`);\n  const ph = document.createElement('div'); ph.className = 'photo';\n  const c = {y, el, slot, photos, k: -1, imgs: [], cur: 0, rest: hang(y), at: 0};\n  lean(c, c.rest);\n  if (photos.length) {   // two layers, each a photo over its softened fill: one showing, the other ready for the next photo\n    c.layers = [0, 1].map(() => {\n      const l = document.createElement('div'), g = new Image(), i = new Image();\n      l.className = 'layer'; g.alt = i.alt = ''; g.className = 'bg'; g.setAttribute('aria-hidden', 'true');\n      l.append(g, i); ph.append(l);\n      return l;\n    });\n    c.imgs = c.layers.map(l => l.lastChild); c.bgs = c.layers.map(l => l.firstChild);\n  } else {\n    ph.classList.add('story'); ph.innerHTML = `<p>${esc(stories[0] || '')}</p>`;\n  }\n  el.innerHTML = '<div class=\"peg\"></div>';\n  el.append(ph);\n  const fest = festOf(cal);\n  const lab = document.createElement('div'); lab.className = 'label';\n  lab.innerHTML = `<div class=\"yr\">${y}</div><div class=\"pl\">${esc(where || '')}</div>` +\n    (cal ? `<div class=\"ti\">${esc(tithiOf(cal))}</div>` : '') + (fest ? `<div class=\"fest\">${esc(fest)}</div>` : '');   // no \"4 of 4\" counter (Darpan, 26 Oct 2026)\n  el.append(lab);\n  const cap = document.createElement('div'); cap.className = 'cap';\n  cap.textContent = photos.length ? '' : 'On this day';\n  slot.append(el, cap); $('cards').append(slot);\n  Object.assign(c, {cap, of: lab.querySelector('.of'), ph});\n  requestAnimationFrame(() => lean(c, c.rest));\n  el.addEventListener('pointermove', e => nudge(c, e));\n  el.addEventListener('pointerleave', () => c.lastX = null);\n  el.addEventListener('pointerdown', e => { c.lastX = e.clientX - 30 * (Math.random() < .5 ? 1 : -1); nudge(c, e); });\n  const close = p => !!(p[4] && p[4][7]);   // want: this card opens on a close up (true) or an activity photo (false)\n  const first = photos.findIndex(p => p[3] && close(p) === want);\n  if (photos.length) show(c, first >= 0 ? first : Math.max(0, photos.findIndex(p => p[3])), true);   // open on a darshan of Bapa\n  if (photos.length > 1) (c.pre = new Image()).src = SRC.photo(photos[(c.k + 1) % photos.length]);   // its next photo loads straight away, ready for the first fade\n  group(y, Y, where, cal, stories);\n  return c;\n}\n\n// Each card hangs a little crooked on its peg, the way real photos do on a cord (Darpan liked the uneven hang, 24 Oct 2026).\n// Brushed by the mouse (or a finger), it swings like a pendulum: out one way, back past straight the other way, and\n// slowly settles, the way a photo really would. Never more than about four degrees from where it hangs.\nconst swinging = new Set();\nfunction hang(y) { let h = y * 2654435761 % 4294967296; h = ((h ^ (h >>> 15)) >>> 0) % 1000 / 1000; return +((h * 2 - 1) * 2.2).toFixed(2); }\nfunction nudge(c, e) {   // only ever moves when someone brushes it, so it stays on even with reduced motion\n  const r = c.el.getBoundingClientRect();\n  const dx = c.lastX == null ? 0 : e.clientX - c.lastX;\n  c.lastX = e.clientX;\n  const low = Math.max(0, Math.min(1, (e.clientY - r.top) / r.height));\n  // a clockwise turn swings the bottom to the left, so a push to the right turns it the other way: it goes where it was hit\n  c.v = Math.max(-.22, Math.min(.22, (c.v || 0) - Math.max(-1, Math.min(1, dx / 30)) * (.3 + low) * .07));\n  c.a = c.a || 0;\n  if (!swinging.size) requestAnimationFrame(swing);\n  swinging.add(c);\n}\n// Swiped sideways on a phone, the cards swing on their cord as the row moves under the finger, a little behind it the\n// way a hanging photo would, and settle back by themselves (Darpan, 28 Oct 2026). Only the cards on the screen move.\nlet lastLeft = null;\n$('cards').addEventListener('scroll', () => {\n  const box = $('cards'), left = box.scrollLeft, dx = lastLeft == null ? 0 : left - lastLeft;\n  lastLeft = left;\n  if (!dx) return;\n  const w = box.clientWidth;\n  cards.forEach(c => {\n    const r = c.slot.getBoundingClientRect();\n    if (r.right < 0 || r.left > w) return;\n    // the row slides left (dx > 0), so the card's bottom trails to the right: an anticlockwise turn\n    c.v = Math.max(-.12, Math.min(.12, (c.v || 0) - Math.max(-1, Math.min(1, dx / 40)) * .018));\n    c.a = c.a || 0;\n    if (!swinging.size) requestAnimationFrame(swing);\n    swinging.add(c);\n  });\n}, {passive: true});\n// the caption under a card leans with it, from the same peg, so it always sits centred under the card (Darpan, 26 Oct 2026)\nfunction lean(c, deg) {   // the card and its caption turn together on the peg, so the caption can never drift off centre\n  c.slot.style.transformOrigin = '50% -12px';\n  c.slot.style.transform = `rotate(${deg}deg)`;\n}\naddEventListener('resize', () => cards.forEach(c => lean(c, c.rest + (c.a || 0))));\nfunction swing() {\n  swinging.forEach(c => {\n    c.v += -c.a * .0033;   // the peg pulls it back towards hanging (one swing there and back takes about two seconds)\n    c.v *= .992;           // and each swing is a little smaller than the last\n    c.a = Math.max(-4, Math.min(4, c.a + c.v));\n    lean(c, (c.rest + c.a).toFixed(3));\n    if (Math.abs(c.a) < .01 && Math.abs(c.v) < .002) { c.a = c.v = 0; lean(c, c.rest); swinging.delete(c); }\n  });\n  if (swinging.size) requestAnimationFrame(swing);\n}\n\nfunction focus(p) { const f = p[4]; return f ? `${(f[0] * 100).toFixed(1)}% ${Math.min(100, f[1] * 115).toFixed(1)}%` : '50% 28%'; }\n\n// make.crop_to, the On this day picture's framing (Darpan, 25 Oct 2026): the photo fills the card around Bapa, his face\n// about 38 percent of the way down, and never slices through his head, pagh included; when his head is bigger than the\n// card it zooms out just enough, and the space left shows the photo's own colours, softened. p[4] is where his face is\n// [centre x, centre y, x, y, w, h, width / height, close darshan], as parts of the photo. Returns true when there is space left.\nfunction frame(img, p) {\n  const box = img.parentNode, w = box.clientWidth, h = box.clientHeight, iw = img.naturalWidth, ih = img.naturalHeight;\n  const f = p[4] && p[4].length > 7 ? p[4] : null;\n  if (!f || !w || !h || !iw || !ih) {   // where his face is isn't known yet: as before\n    img.classList.remove('placed'); img.removeAttribute('style'); img.style.objectPosition = focus(p); return false;\n  }\n  let [cw, ch] = iw / ih > w / h ? [ih * w / h, ih] : [iw, iw * h / w];\n  const fx = f[2] * iw, fy = f[3] * ih, fw = f[4] * iw, fh = f[5] * ih;\n  const head = [fx - .35 * fw, fy - .5 * fh, fx + 1.35 * fw, fy + 1.4 * fh];   // the detector's box starts at the brow\n  const grow = Math.max(1, (head[2] - head[0]) / cw / .96, (head[3] - head[1]) / ch / .96);\n  cw *= grow; ch *= grow;\n  let x0 = fx + fw / 2 - cw / 2, y0 = fy + fh / 2 - ch * .38;\n  y0 = Math.min(Math.max(y0, head[3] - ch), head[1]);   // never slice through the head\n  y0 = Math.max(y0, head[1] - ch * .14);                 // and not much space above it\n  x0 = Math.min(Math.max(x0, head[2] - cw), head[0]);\n  x0 = cw <= iw ? Math.min(Math.max(0, x0), iw - cw) : (iw - cw) / 2;\n  y0 = ch <= ih ? Math.min(Math.max(0, y0), ih - ch) : (ih - ch) / 2;\n  img.classList.add('placed');\n  // the slow drift closes in on his face, never so far that it cuts into his head\n  const ox = fx + fw / 2, oy = fy + fh / 2, fit = (edge, far) => far > 0 ? edge / far : 9;\n  const room = Math.min(fit(ox - x0, ox - head[0]), fit(x0 + cw - ox, head[2] - ox), fit(oy - y0, oy - head[1]), fit(y0 + ch - oy, head[3] - oy));\n  img.style.setProperty('--zoom', Math.max(1, Math.min(1.08, room * .99)).toFixed(3));\n  img.style.setProperty('--fx', (ox / iw * 100).toFixed(1) + '%');\n  img.style.setProperty('--fy', (oy / ih * 100).toFixed(1) + '%');\n  Object.assign(img.style, {width: iw / cw * 100 + '%', height: ih / ch * 100 + '%', left: -x0 / cw * 100 + '%', top: -y0 / ch * 100 + '%'});\n  return cw > iw + 1 || ch > ih + 1;\n}\naddEventListener('resize', () => cards.forEach(c => (c.imgs || []).forEach((i, n) => { if (!i.p) return; const gap = frame(i, i.p), g = c.bgs[n]; g.hidden = !gap; if (gap && g.src !== i.src) g.src = i.src; })));\n\nfunction show(c, k, first) {\n  const p = c.photos[k], url = SRC.photo(p);\n  c.k = k;\n  // a photo not copied to the website yet: the card shows its caption in the frame instead, like a diary line\n  const done = missing => {\n    if (c.of) c.of.textContent = `${k + 1} of ${c.photos.length}`;\n    let w = c.ph.querySelector('.words');\n    if (missing && !w) { c.ph.insertAdjacentHTML('beforeend', '<div class=\"words\"><p></p></div>'); w = c.ph.querySelector('.words'); }\n    if (w) {\n      const t = w.querySelector('p');\n      if (missing && t.textContent && !w.classList.contains('off')) {   // a caption already in the frame fades into the next\n        t.style.opacity = 0;\n        setTimeout(() => { t.textContent = p[2] || 'Darshan'; t.style.opacity = 1; }, 1500);\n      } else if (missing) t.textContent = p[2] || 'Darshan';\n      w.classList.toggle('off', !missing);\n    }\n    c.cap.classList.add('fade');\n    setTimeout(() => { c.cap.textContent = p[5] || p[2]; c.cap.classList.remove('fade'); }, first ? 0 : 1500);\n  };\n  if (!url) return done(true);\n  // the hidden layer takes the next photo; it only fades in once the photo is fully loaded and ready to paint, so a\n  // change never starts half drawn, and a photo that will not load is simply passed over\n  const i = first ? 0 : 1 - c.cur, layer = c.layers[i], next = c.imgs[i], bg = c.bgs[i], ticket = c.ticket = (c.ticket || 0) + 1;\n  c.busy = true;\n  const give = () => { if (ticket === c.ticket) c.busy = false; };\n  const wait = setTimeout(give, 15000);\n  const swap = () => {\n    if (ticket !== c.ticket) return;\n    clearTimeout(wait);\n    next.p = p;\n    const gap = frame(next, p);\n    bg.hidden = !gap; if (gap) bg.src = url;\n    next.style.setProperty('--wait', `-${(Math.random() * 20).toFixed(1)}s`);   // each card drifts out of step with the rest\n    const old = c.layers[c.cur];\n    c.cur = i; done(false);\n    if (first) { layer.classList.add('on'); c.busy = false; return; }\n    layer.classList.add('top'); void layer.offsetWidth; layer.classList.add('on');\n    setTimeout(() => {   // covered: the old photo goes, and this card may change again\n      if (ticket !== c.ticket) return;\n      old.classList.remove('on'); layer.classList.remove('top'); c.busy = false;\n    }, reduce ? 1300 : 3100);\n  };\n  next.onload = () => (next.decode ? next.decode().catch(() => {}) : Promise.resolve()).then(() => requestAnimationFrame(swap));\n  next.onerror = () => { if (ticket !== c.ticket) return; clearTimeout(wait); c.busy = false; done(true); };\n  next.src = url;\n  const after = c.photos[(k + 1) % c.photos.length], ahead = after && after !== p && SRC.photo(after);\n  if (ahead) (c.pre = new Image()).src = ahead;   // the card's next photo loads quietly now, so its change is ready when its turn comes\n}\n\n// The board is always moving: every second one of the cards on the screen starts fading to its next photo, the one that\n// has waited longest going first, so the fades follow one another and never start together (Darpan, 28 Oct 2026: \"in the\n// first second, a picture should fade. The next second, another picture\"). A card rests at least four seconds\n// between changes, and cards off the screen wait until they are seen. A year with a single photo keeps it, drifting gently.\nconst inView = new Set();\nconst watch = 'IntersectionObserver' in window ? new IntersectionObserver(es => es.forEach(e => {\n  const c = cards.find(x => x.el === e.target);\n  if (c) e.isIntersecting ? inView.add(c) : inView.delete(c);\n}), {threshold: .35}) : null;\nlet last = null;\nfunction beat() {\n  const rest = 4000 * (reduce ? 1.6 : 1), t = Date.now();\n  const ready = cards.filter(c => c.photos.length > 1 && !c.busy && t - c.at >= rest && c !== last && (!watch || inView.has(c)) && (!c.pre || c.pre.complete))   // next photo already here, so the fade starts on the beat\n    .sort((a, b) => a.at - b.at);\n  const c = ready[Math.floor(Math.random() * Math.min(3, ready.length))];   // one of the three that waited longest\n  if (c) { last = c; c.at = t; show(c, (c.k + 1) % c.photos.length); }\n}\nfunction start() {\n  stop();\n  if (paused || document.hidden) return;\n  if (watch) { inView.clear(); cards.forEach(c => watch.observe(c.el)); }\n  // the first fade starts within a second of opening, then a new one every second (Darpan, 28 Oct 2026: \"the fades are\n  // constantly running\", never a still page while it settles)\n  const every = +$('speed').value * (reduce ? 1.6 : 1);\n  timers.push(setTimeout(() => { beat(); timers.push(setInterval(beat, every)); }, Math.min(800, every)));\n}\nfunction stop() { timers.forEach(clearInterval); timers = []; if (watch) watch.disconnect(); }\n$('pause').onclick = () => { paused = !paused; $('pause').textContent = paused ? 'Play' : 'Pause'; $('board').classList.toggle('paused', paused); start(); };\n$('speed').onchange = start;\ndocument.addEventListener('visibilitychange', () => document.hidden ? stop() : start());\n\n// how many cards on each rope: the top ropes full, then only the bottom ropes step down one card at a time, never\n// more than the rope above, never more than one fewer, never below half a full rope (Darpan, 29 Oct 2026: \"want top\n// rows to be full, just the bottom ones\"). Most full ropes wins, then the fullest top rope, then the most steps, then the fewest ropes\n// (today's 30 cards: 8, 8, 7, 7; 26: 8, 7, 6, 5; 21: 8, 7, 6; 13: 7, 6; 5: 5)\nfunction steps(total, fit) {\n  let best = [total], score = -1;\n  const low = Math.ceil(fit / 2), c = [];\n  (function walk(left, top) {\n    if (!left) {\n      const s = c.filter(k => k === fit).length * 1e6 + c[0] * 1e4 + new Set(c).size * 100 - c.length;\n      if (s > score) { score = s; best = c.slice(); }\n      return;\n    }\n    for (let k = Math.min(top, left); k >= (c.length ? Math.max(1, top - 1) : 1); k--) {   // the top rope may hold fewer than fit\n      if (k < low && k !== left) continue;   // only a lone short rope may sit below half\n      c.push(k); walk(left - k, k); c.pop();\n    }\n  })(total, fit);\n  return best;\n}\n\n// one cord per row of cards, drawn through the pegs\nfunction cords() {\n  // the cords run the full width of the window, edge to edge (Darpan, 24 Oct 2026). On computers the cards fill that\n  // width too, as many to a row as fit, and each row hangs in a real curve: the rope sags in the middle and the cards\n  // ride on it, the side ones a little higher (Darpan, 26 Oct 2026)\n  const svg = $('cords'), board = $('board'), vw = document.documentElement.clientWidth, wide = vw > 760, rows = {};\n  if (wide) {\n    const w = board.parentElement.getBoundingClientRect(), g = Math.max(40, vw * .035);   // a safe gap from the window edge (Darpan, 26 Oct 2026: \"a tiny bit more breathing space\")\n    board.style.marginLeft = Math.round(g - w.left) + 'px'; board.style.marginRight = Math.round(g - (vw - w.right)) + 'px';\n  } else board.style.marginLeft = board.style.marginRight = '';\n  // bigger cards, up to 8 to a rope, and each rope down holds one fewer, stepping gently (8, 7, 6, 5), every rope\n  // centred (Darpan, 29 Oct 2026: \"8 and then 7, 6, 5. So it's spread out across and everything should be centered\").\n  // The grid has two columns per card, so a rope one card shorter starts half a card in and sits in the middle.\n  const grid = $('cards');\n  if (wide) {\n    const gw = grid.clientWidth, gap = parseFloat(getComputedStyle(grid).columnGap) || 20, fit = Math.max(1, Math.min(8, Math.floor((gw + gap) / (168 + gap))));\n    const per = steps(cards.length, fit), n = per[0] || 1;\n    grid.style.gridTemplateColumns = `repeat(${2 * n},minmax(0,1fr))`;\n    let i = 0;\n    per.forEach(k => { for (let j = 0; j < k; j++, i++) cards[i].slot.style.gridColumn = `${j ? 'auto' : n - k + 1} / span 2`; });\n  } else { grid.style.gridTemplateColumns = ''; cards.forEach(c => c.slot.style.gridColumn = ''); }\n  cards.forEach(c => lean(c, c.rest + (c.a || 0)));   // the cards changed size: each caption swings from the new peg height\n  const b = board.getBoundingClientRect(), D = wide ? Math.min(64, vw * .032) : 0;\n  svg.style.left = -b.left + 'px'; svg.style.width = vw + 'px';\n  $('cards').style.paddingTop = (16 + D / 2) + 'px';\n  cards.forEach(c => {\n    rows[c.slot.offsetTop] = 1;\n    const r = c.slot.getBoundingClientRect(), t = (r.left + r.width / 2) / vw;   // where the peg is across the window, 0 to 1\n    c.slot.style.translate = D ? `0 ${(D * (1 - (2 * t - 1) ** 2) - D / 2).toFixed(1)}px` : '';\n  });\n  svg.innerHTML = `<defs><filter id=\"ropeshade\" x=\"-5%\" y=\"-50%\" width=\"110%\" height=\"200%\"><feDropShadow dx=\"0\" dy=\"3\" stdDeviation=\"2.2\" flood-color=\"#000\" flood-opacity=\".45\"/></filter></defs>` +\n    Object.keys(rows).map(t => {\n      const y = +t - 5, a = y - D / 2, q = y + 1.5 * D;   // a parabola: ends D/2 above the pegs' line, middle D/2 below\n      const d = `M 0 ${a.toFixed(1)} Q ${vw / 2} ${q.toFixed(1)} ${vw} ${a.toFixed(1)}`;\n      // a twisted rope: a dark core, the strands, short slanted shadows where they twist, and a light catch on top\n      return `<g filter=\"url(#ropeshade)\"><path d=\"${d}\" fill=\"none\" stroke=\"#5a3a1c\" stroke-width=\"6.5\" stroke-linecap=\"round\"/>` +\n        `<path d=\"${d}\" fill=\"none\" stroke=\"var(--cord)\" stroke-width=\"5\"/>` +\n        `<path d=\"${d}\" fill=\"none\" stroke=\"#7a5228\" stroke-width=\"5\" stroke-dasharray=\"2.2 3.6\" opacity=\".75\"/>` +\n        `<path d=\"${d}\" fill=\"none\" stroke=\"#f1d9a8\" stroke-width=\"1.2\" stroke-dasharray=\"3.6 2.2\" stroke-dashoffset=\"1\" opacity=\".55\" transform=\"translate(0 -1.3)\"/></g>`;\n    }).join('');\n}\naddEventListener('resize', () => requestAnimationFrame(cords));\nnew ResizeObserver(() => requestAnimationFrame(cords)).observe($('cards'));\ndocument.fonts && document.fonts.ready.then(cords);\n\n// every photo of the day, year by year\nfunction group(y, Y, where, cal, stories) {\n  if (!Y && !stories.length) return;\n  const g = document.createElement('section'); g.className = 'yeargroup'; g.id = 'y' + y;\n  const fest = festOf(cal);\n  g.innerHTML = `<div class=\"yhead\"><h3>${y}</h3><span class=\"caps\">${esc(where || '')}</span>` +\n    (cal ? `<span class=\"it\">${esc(cal[0])}</span>` : '') + (fest ? `<span class=\"fest\">${esc(fest)}</span>` : '') +\n    `<a class=\"go\" href=\"${esc(SRC.search(y + '-' + DAY.date))}\">See more &rsaquo;</a></div>` +\n    stories.map(s => `<p class=\"story-line\"><b>On this day</b>${esc(s)}</p>`).join('');\n  const add = (list, note) => {\n    if (!list || !list.length) return;\n    if (note) g.insertAdjacentHTML('beforeend', `<p class=\"tripnote\">${note}</p>`);\n    const grid = document.createElement('div'); grid.className = 'thumbs';\n    list.forEach(p => {\n      const i = everyPhoto.length;\n      everyPhoto.push({p, y, where, cal, trip: note ? Y.trip : null});\n      const b = document.createElement('button'); b.className = 'thumb'; b.type = 'button';\n      const url = SRC.photo(p);\n      b.innerHTML = `<span class=\"im\">${url ? `<img loading=\"lazy\" decoding=\"async\" alt=\"${esc(p[2])}\" src=\"${esc(url)}\" style=\"object-position:${focus(p)}\">` : ''}</span><small>${esc(p[2] || 'Darshan')}</small>`;\n      const im = b.querySelector('.im'), words = () => { im.classList.add('words'); im.textContent = p[2] || 'Darshan'; };\n      if (!url) words(); else b.querySelector('img').onerror = words;\n      b.onclick = () => view(i);\n      grid.append(b);\n    });\n    g.append(grid);\n  };\n  if (Y) add(Y.p);\n  if (Y && Y.trip) add(Y.t, `${Y.p.length ? 'From the same trip' : 'From these days'}, ${tripText(Y.trip)}`);\n  $('groups').append(g);\n}\nfunction tripText([a, b]) {\n  const d = s => `${+s.slice(8)} ${MONTHS[+s.slice(5, 7) - 1]}`;\n  return a === b ? d(a) : `${d(a)} to ${d(b)}`;\n}\n\n// the wide view, which is also the slideshow\nlet vi = 0, vtimer = null, lastFocus = null;\nfunction view(i, play) {\n  if (!everyPhoto.length) return;\n  if ($('viewer').hidden) { lastFocus = document.activeElement; $('viewer').hidden = false; document.body.style.overflow = 'hidden'; $('vclose').focus(); }\n  vi = (i + everyPhoto.length) % everyPhoto.length;\n  const {p, y, where, cal, trip} = everyPhoto[vi];\n  const url = SRC.big(p) || SRC.photo(p);\n  const when = trip ? tripText(trip) + ' ' + y : `${DAY.title} ${y}`;\n  const none = `<div class=\"none\">${esc(p[2] || 'Darshan')}</div>`;\n  $('vstage').innerHTML = `<figure class=\"vframe\" style=\"margin:0\">${url ? `<img alt=\"${esc(p[2])}\" src=\"${esc(url)}\">` : none}` +\n    `<figcaption class=\"vcap\"><p>${esc(p[2] || 'Darshan')}</p><div>${esc([when, where, cal && cal[0], festOf(cal)].filter(Boolean).join(' · '))}</div>` +\n    `<a class=\"go\" href=\"${esc(trip && trip[0] !== trip[1] ? `/search/#place=${encodeURIComponent(String(where || '').split(',')[0])}&from=${trip[0]}&to=${trip[1]}` : SRC.search(trip ? trip[0] : y + '-' + DAY.date))}\">See more &rsaquo;</a></figcaption></figure>`;\n  const img = $('vstage').querySelector('img');\n  if (img) img.onerror = () => img.outerHTML = none;\n  $('vpos').textContent = `${vi + 1} of ${everyPhoto.length}`;\n  if (play !== undefined) setPlay(play);\n  const n = everyPhoto[(vi + 1) % everyPhoto.length].p, pre = SRC.big(n) || SRC.photo(n);\n  if (pre) new Image().src = pre;   // the next photo is ready before it is needed\n}\nfunction setPlay(on) {\n  clearInterval(vtimer); vtimer = null;\n  $('viewer').classList.toggle('play', on);\n  $('vplay').textContent = on ? 'Pause' : 'Play';\n  if (on) vtimer = setInterval(() => view(vi + 1), reduce ? 9000 : 6000);\n}\nfunction shut() {\n  setPlay(false); $('viewer').hidden = true; document.body.style.overflow = '';\n  if (document.fullscreenElement) document.exitFullscreen().catch(() => {});\n  lastFocus && lastFocus.focus();\n}\n$('vclose').onclick = shut;\n// a click on the dark around the photo closes it, back to the page underneath (Darpan, 26 Oct)\n$('viewer').addEventListener('click', e => { if (!e.target.closest('.vframe, button, a')) shut(); });\n$('vprev').onclick = () => view(vi - 1);\n$('vnext').onclick = () => view(vi + 1);\n$('vplay').onclick = () => setPlay(!vtimer);\n$('slideshow').onclick = () => {\n  view(0, true);\n  const fs = $('viewer').requestFullscreen; if (fs) fs.call($('viewer')).catch(() => {});\n};\nlet sx = null;\n$('vstage').addEventListener('touchstart', e => sx = e.touches[0].clientX, {passive: true});\n$('vstage').addEventListener('touchend', e => { if (sx === null) return; const dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 40) view(vi + (dx < 0 ? 1 : -1)); sx = null; });\n\n// choosing a day\nlet pm = 0;\nfunction month(m) {\n  pm = (m + 12) % 12;\n  $('pm-name').textContent = MONTHS[pm];\n  $('daygrid').innerHTML = '';\n  for (let d = 1; d <= LEN[pm]; d++) {\n    const k = pad(pm + 1) + '-' + pad(d), b = document.createElement('button');\n    b.type = 'button'; b.textContent = d; b.setAttribute('aria-label', `${d} ${MONTHS[pm]}`);\n    if (k === showing) b.className = 'on'; if (k === TODAY) b.classList.add('today');\n    b.onclick = () => { $('picker').hidden = true; open(k, true); scrollTo({top: 0}); };\n    $('daygrid').append(b);\n  }\n}\n$('choose').onclick = () => { month(+showing.slice(0, 2) - 1); $('picker').hidden = false; $('pm-name').focus && $('daygrid').querySelector('.on, button').focus(); };\n$('pm-prev').onclick = () => month(pm - 1);\n$('pm-next').onclick = () => month(pm + 1);\n$('pclose').onclick = () => { $('picker').hidden = true; $('choose').focus(); };\n$('picker').addEventListener('click', e => { if (e.target === $('picker')) $('pclose').click(); });\n$('prev').onclick = () => open(shift(showing, -1), true);\n$('next').onclick = () => open(shift(showing, 1), true);\n$('back-today').onclick = () => open(TODAY, true);\n\naddEventListener('keydown', e => {\n  if (!$('picker').hidden && e.key === 'Escape') { $('pclose').click(); return; }\n  if ($('viewer').hidden) return;\n  if (e.key === 'Escape') shut();\n  else if (e.key === 'ArrowRight') view(vi + 1);\n  else if (e.key === 'ArrowLeft') view(vi - 1);\n});\naddEventListener('hashchange', () => { if (/^#\\d\\d-\\d\\d$/.test(location.hash) || !location.hash) open(wanted()); });\n\nopen(wanted());\n// left open overnight (a tablet on a stand), today's page moves on to the new day at midnight, like the TV player\n// (whole website review, 28 Oct 2026); a day someone picked stays as it is\nsetInterval(() => {\n  const d = new Date(), t = pad(d.getMonth() + 1) + '-' + pad(d.getDate());\n  if (t === TODAY) return;\n  const was = TODAY;\n  now = d; TODAY = t;\n  if (showing === was) open(TODAY, true);\n}, 60000);\n</script>\n\n<script type=\"module\" src=\"https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092\" integrity=\"sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==\" data-cf-beacon='{\"version\":\"2024.11.0\",\"token\":\"f5db45f6a81d4268ad185def7630ee75\",\"r\":1,\"spa\":2}' crossorigin=\"anonymous\"></script>\n</body>\n</html>\n"
