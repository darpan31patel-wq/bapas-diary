            "compression": 3487,
            "text": "/* The full screen player (site/player/player.js), in the site's own look: deep maroon, gold Garamond, ivory words.\n   Website only (bapas-diary.com). Every class starts with pl- so it never clashes with a page. */\n.pl-showing, .pl-showing body { overflow: hidden; }\n.pl-show { position: fixed; inset: 0; z-index: 3000; zoom: calc(1 / var(--bd-zoom, 1)); container-type: size; background: #0c0204; color: #faf1de;\n  cursor: none; outline: 0; overflow: hidden; -webkit-tap-highlight-color: transparent;\n  --pl-gold: #d9a441; --pl-gold-hi: #ffe296; --pl-serif: \"EB Garamond\", \"Diary Garamond\", Garamond, \"Times New Roman\", serif; --pl-sans: Arimo, \"Diary Arimo\", Arial, sans-serif; }\n.pl-show.awake, .pl-show.paused, .pl-show.waiting { cursor: default; }\n\n/* each photo as big as the screen allows, never cut; around it the same photo, soft and dark */\n.pl-slide { position: absolute; inset: 0; opacity: 0; transition: opacity 3s ease; }\n.pl-slide.on { opacity: 1; }\n.pl-bg { position: absolute; inset: -6%; width: 112%; height: 112%; object-fit: cover; filter: blur(40px) brightness(.35) saturate(1.2); }\n.pl-drift { position: absolute; inset: 0; display: grid; place-items: center; }\n.pl-slide.on .pl-drift { animation: pl-drift var(--pl-time, 16s) ease-out both; }\n@keyframes pl-drift { from { transform: scale(1); } to { transform: scale(1.06); } }\n.pl-im { display: block; width: 100cqw; height: 100cqh; object-fit: contain; filter: drop-shadow(0 0 5cqh rgba(0, 0, 0, .6)); }\n.pl-none { position: absolute; inset: 0; display: grid; place-items: center; font: italic 500 4cqh var(--pl-serif); color: var(--pl-gold-hi); }\n\n/* both Bapas and the day, softly in the corner */\n.pl-badge { position: absolute; top: calc(3cqh + env(safe-area-inset-top, 0px)); left: 2.5cqw; display: flex; align-items: center; gap: 1.4cqh;\n  padding: .9cqh 2.2cqh .9cqh .9cqh; border-radius: 99px; background: rgba(12, 2, 4, .45); backdrop-filter: blur(6px); opacity: .85; }\n.pl-gurus { display: flex; }\n.pl-gurus img { width: 5.4cqh; height: 5.4cqh; border-radius: 50%; border: .3cqh solid var(--pl-gold); object-fit: cover; background: #42101c; }\n.pl-gurus img + img { margin-left: -1.2cqh; }\n.pl-badge span:last-child { display: grid; line-height: 1.15; }\n.pl-badge b { font: 700 1.5cqh var(--pl-sans); letter-spacing: .28em; text-transform: uppercase; color: var(--pl-gold); }\n.pl-badge i { font: 600 2.5cqh var(--pl-serif); font-style: normal; color: var(--pl-gold-hi); }\n\n/* the year, the place, the day and what Bapa does: one centred line across the whole screen, over a soft shade */\n.pl-words { position: absolute; left: 0; right: 0; bottom: 0; padding: 12cqh 3cqw calc(4cqh + env(safe-area-inset-bottom, 0px));\n  background: linear-gradient(transparent, rgba(8, 1, 3, .6) 50%, rgba(8, 1, 3, .82)); text-align: center; text-wrap: balance;\n  font: 600 3.4cqh/1.35 var(--pl-serif); color: #faf1de; opacity: 0; transition: opacity 1.2s ease; pointer-events: none; text-shadow: 0 .2cqh 1cqh rgba(0, 0, 0, .7); }\n.pl-words.on { opacity: 1; }\n.pl-words b { font: 700 1.3em/1 var(--pl-serif); color: var(--pl-gold-hi); }\n.pl-words span::before, .pl-words i::before { content: \"·\"; margin: 0 .55em; color: var(--pl-gold); font-style: normal; }\n.pl-words span { white-space: nowrap; }\n.pl-words i { font-weight: 500; color: rgba(250, 241, 222, .88); }\n\n/* the buttons only show when the mouse moves or a key is pressed */\n.pl-bar { position: absolute; right: 2.5cqw; top: calc(3cqh + env(safe-area-inset-top, 0px)); display: flex; align-items: center; gap: 10px;\n  opacity: 0; transition: opacity .4s; pointer-events: none; }\n.pl-show.awake .pl-bar, .pl-show.paused .pl-bar { opacity: 1; pointer-events: auto; }\n.pl-bar button { min-width: 48px; min-height: 48px; font: 700 13px var(--pl-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--pl-gold-hi);\n  background: rgba(12, 2, 4, .6); border: 1px solid rgba(217, 164, 65, .45); border-radius: 999px; padding: 0 18px; cursor: pointer; }\n.pl-bar button[aria-label] { font: 500 28px/1 var(--pl-serif); padding: 0 14px 4px; letter-spacing: 0; }\n.pl-bar button:focus-visible, .pl-start button:focus-visible { outline: 3px solid var(--pl-gold-hi); outline-offset: 3px; }\n.pl-grow { width: 90px; height: 3px; background: rgba(255, 255, 255, .18); border-radius: 2px; overflow: hidden; }\n.pl-grow i { display: block; height: 100%; width: 0; background: var(--pl-gold); }\n\n/* opened from the address (?play): one tap, or OK on the remote, to begin */\n.pl-start { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 2cqh; text-align: center; padding: 24px;\n  background: radial-gradient(circle at 50% 40%, #4a1220, #160509 70%); }\n.pl-start .pl-gurus img { width: 16cqh; height: 16cqh; border-width: .5cqh; }\n.pl-start .pl-gurus img + img { margin-left: 2cqh; }\n.pl-start h2 { margin: 1cqh 0 0; font: 600 7cqh/1 var(--pl-serif); color: var(--pl-gold-hi); }\n.pl-start p { margin: 0; font: 500 3.6cqh var(--pl-serif); }\n.pl-start button { margin-top: 2cqh; font: italic 600 3.6cqh var(--pl-serif); color: #2a0a10; background: linear-gradient(#ffe296, #d9a441); border: 0;\n  border-radius: 999px; padding: 1.4cqh 6cqh; cursor: pointer; box-shadow: 0 1cqh 3cqh rgba(0, 0, 0, .45); }\n.pl-start small { font: 600 1.7cqh var(--pl-sans); letter-spacing: .2em; text-transform: uppercase; color: var(--pl-gold); }\n.pl-show.waiting .pl-badge, .pl-show.waiting .pl-words, .pl-show.waiting .pl-bar { display: none; }\n\n/* a phone held upright: the words in the middle, the buttons at the bottom */\n@container (max-aspect-ratio: 1/1) {\n  .pl-words { padding-inline: 6cqw; font-size: 2.6cqh; }\n  .pl-bar { top: auto; bottom: calc(2cqh + env(safe-area-inset-bottom, 0px)); left: 0; right: 0; justify-content: center; flex-wrap: wrap; }\n  .pl-grow { display: none; }\n  .pl-show.awake .pl-words { opacity: 0; }\n}\n@media (prefers-reduced-motion: reduce) { .pl-slide { transition-duration: 1.2s; } .pl-slide.on .pl-drift { animation: none; } }\n"
